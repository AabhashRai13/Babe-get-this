{
  "name": "pebbles-studio",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "Remotion kit for Mr & Mrs Pebbles videos. Media lives in ~/Documents/Pebbles Videos, never in git.",
  "scripts": {
    "studio": "remotion studio",
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "render": "node scripts/render.mjs",
    "analyze": "node scripts/analyze.mjs",
    "sheets": "node scripts/sheets.mjs",
    "smoke": "npm run typecheck && npm test && npm run sheets"
  },
  "dependencies": {
    "@remotion/cli": "4.0.543",
    "@remotion/google-fonts": "4.0.543",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "remotion": "4.0.543"
  },
  "devDependencies": {
    "@types/node": "^26.6.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "esbuild": "0.28.1",
    "typescript": "^7.0.2",
    "vitest": "^5.1.0"
  }
}
