<?xml version="1.0" encoding="utf-8"?><!--
   Backup/transfer rules for API 31+ (older devices use backup_rules.xml).

   bgt_secure_prefs is EncryptedSharedPreferences: its Keystore master key
   never leaves the device, so a backed-up or transferred copy is
   undecryptable at best — and at worst carries a previous user's session
   onto a device that never logged in. Exclude it from both paths.
-->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="sharedpref" path="bgt_secure_prefs.xml" />
    </cloud-backup>
    <device-transfer>
        <exclude domain="sharedpref" path="bgt_secure_prefs.xml" />
    </device-transfer>
</data-extraction-rules>
